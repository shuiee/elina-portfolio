---
/* Persistent orientation. The source deck kept a fixed 01-04 index plus a stage
   progress bar visible at all times; this keeps the intent.

   Desktop: a sticky column listing the projects, so the reader can move between
   them without going back to the index.
   Mobile: the column is hidden and a 3px progress bar pins under the header.
   The FILLED part is --ink (21:1), never a colour, so the indicator survives
   any ambient condition. Finding 4: decision-critical information stays visible.
*/
import { href } from '../lib/url.js';
const { number, projects = [] } = Astro.props;
---
<nav class="rail" aria-label="Where you are">
  <ol class="rail__projects" aria-label="All projects">
    {projects.map((p) => (
      <li>
        <a href={href(`/work/${p.id}/`)} class="figure-num" aria-current={p.number === number ? 'page' : undefined}>
          {p.number}
        </a>
        <span class="rail__projtitle">{p.shortTitle}</span>
      </li>
    ))}
  </ol>
</nav>

<div class="rail__bar" aria-hidden="true"><span class="rail__barfill"></span></div>

<style>
  .rail { display: none; }
  @media (min-width: 1000px) {
    .rail {
      display: block;
      position: sticky;
      top: var(--space-7);
      align-self: start;
      width: var(--rail-width);
      font-size: var(--size-2);
    }
  }
  .rail__projects {
    list-style: none;
    padding: var(--space-5) 0 0;
    margin: var(--space-6) 0 0;
    border-top: var(--border-hair) solid var(--rule);
    display: grid;
    gap: var(--space-3);
  }
  .rail__projects li { display: flex; gap: var(--space-3); align-items: baseline; }
  .rail__projects a { text-decoration: none; color: var(--ink-quiet); font-size: var(--size-3); }
  .rail__projects a[aria-current='page'] { color: var(--ink); font-weight: var(--weight-bold); }
  .rail__projects a:hover { color: var(--ink); text-decoration: underline; }
  .rail__projtitle {
    font-size: var(--size-1);
    color: var(--ink-quiet);
    line-height: var(--leading-body);
  }

  /* Mobile progress bar */
  .rail__bar {
    position: sticky;
    top: 0;
    z-index: 5;
    height: 3px;
    background: var(--rule);
  }
  @media (min-width: 1000px) { .rail__bar { display: none; } }
  .rail__barfill {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--ink);
  }
</style>

<script>
  /* Two jobs, both orientation, neither decorative:
     1. mark the current section in the sticky rail
     2. fill the mobile progress bar to match scroll position
     Both are position updates, not animation, so prefers-reduced-motion does
     not need to disable them — but neither moves anything the reader is
     reading. */
  const fill = document.querySelector('.rail__barfill');

  function update() {
    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    if (fill) fill.style.width = (max > 0 ? Math.min(100, (doc.scrollTop / max) * 100) : 0) + '%';
  }

  let ticking = false;
  addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => { update(); ticking = false; });
  }, { passive: true });
  addEventListener('resize', update, { passive: true });
  update();
</script>
