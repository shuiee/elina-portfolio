---
/* A pile of reference material, laid out the way it sat on the board.

   These are artefacts, not interface: ten attempts at encoding the same
   record, kept because the set is the argument. So the arrangement is loose
   and overlapping rather than a tidy grid, which is what a grid of ten dark
   tiles would be: a contact sheet, implying each one is equally finished.

   Nothing here is interactive. Hover lifts a card, but it is decoration for a
   mouse and nothing is hidden behind it: every card carries its own label and
   its own alt text, and they read in order. Making them focusable would put
   ten stops in the keyboard path that lead nowhere.

   Offsets and rotations are derived from the index, not random, so the pile
   is identical on every build and does not reshuffle under the reader.

   items = [[src, alt, label], ...]
*/
import { asset } from '../lib/url.js';
const { items = [], caption } = Astro.props;

/* Fixed sequences rather than Math.random: a pile that rearranges itself on
   every deploy is a diff with no author. Nine values, ten cards, so the
   pattern does not line up with the three-column grid and repeat. */
const TILT = [-2.4, 1.6, -1.1, 2.2, -1.8, 0.9, -2.7, 1.3, -0.6, 2.0];
const DROP = [0, 26, 10, 34, 6, 22, 14, 30, 4, 18];
---
<figure class="pile reveal">
  <ul>
    {items.map(([src, alt, label], i) => (
      <li style={`--tilt:${TILT[i % TILT.length]}deg; --drop:${DROP[i % DROP.length]}px; --z:${i}`}>
        <img src={asset(src)} alt={alt} loading="lazy" decoding="async" />
        {label && <span class="pile__label">{label}</span>}
      </li>
    ))}
  </ul>
  {caption && <figcaption class="pile__cap meta">{caption}</figcaption>}
</figure>

<style>
  .pile { margin: var(--space-6) 0 0; max-width: none; }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    /* Negative column gap is what makes it a pile: cards sit over their
       neighbours by a sliver rather than in tidy lanes. Kept to -16px: at
       -24px the widest label ran under the card in the next column. */
    gap: var(--space-6) calc(var(--space-4) * -1);
    align-items: start;
    max-width: none;
  }

  li {
    position: relative;
    z-index: var(--z);
    margin-top: var(--drop);
    transform: rotate(var(--tilt));
    transform-origin: 50% 40%;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border: var(--border-hair) solid var(--rule);
    /* Tinted to the page rather than a black drop shadow, so the pile reads
       as paper on paper and not as floating UI. */
    box-shadow: 0 2px 10px rgb(69 73 80 / 0.16);
    background: var(--field);
  }

  .pile__label {
    display: block;
    margin-top: var(--space-2);
    /* Inset past the overlap. Each card sits --space-4 over the one in the
       column to its left, so a label flush to this card's box starts on top
       of that dark neighbour, where grey-on-near-black is unreadable: the
       first word simply disappeared. The extra 8px covers the tilt. */
    padding-left: calc(var(--space-4) + 8px);
    font-size: var(--size-1);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-quiet);
  }
  /* First column has nothing to its left to clear. */
  li:nth-child(3n + 1) .pile__label { padding-left: 0; }

  .pile__cap { margin-top: var(--space-6); max-width: var(--measure); }

  /* Mouse decoration only. Lifting on hover is how you look at one card in a
     real pile, and it needs no state and no script. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    li { transition: transform 180ms ease-out; }
    li:hover {
      transform: rotate(0deg) translateY(-4px) scale(1.03);
      z-index: 20;
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: reduce) {
    li:hover { transform: rotate(0deg); z-index: 20; }
  }

  /* Two columns from tablet down, and below 620px the pile straightens out
     into a plain column: overlapping tilted cards 150px wide are a mess, and
     the labels start colliding with the card above. */
  @media (max-width: 900px) {
    ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6) calc(var(--space-4) * -1); }
    /* Two columns, so the clear column is every 2nd, not every 3rd. */
    li:nth-child(3n + 1) .pile__label { padding-left: calc(var(--space-4) + 8px); }
    li:nth-child(2n + 1) .pile__label { padding-left: 0; }
  }
  @media (max-width: 620px) {
    ul { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); }
    li { transform: none; margin-top: 0; }
    /* One column: nothing overlaps anything, so no inset at all. */
    li .pile__label { padding-left: 0; }
  }
</style>
