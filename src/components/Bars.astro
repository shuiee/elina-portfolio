---
/* A distribution, drawn as bars and marked up as a table.

   The table is the real thing here. A screen reader gets a label, a number
   and a share for every row, in order; the bars are a fill drawn behind the
   number for everyone else. That way the chart costs nothing in information,
   which matters on a page whose argument is that the evidence is uneven.

   Bars are sized against the LARGEST value, not against the total, because
   the question these answer is always "how does this one compare with the
   biggest", not "what fraction of everything is it".

   items    = [[label, value, meta?], ...]   meta is an optional second line
   mark     = labels to pick out: the row the surrounding text is about
   unit     = what the numbers count, named once in the header
   share    = true adds a per-row percentage column
*/
const {
  items = [],
  unit = '',
  mark = [],
  caption,
  note,
  share = false,
  label = 'Distribution',
} = Astro.props;

const max = Math.max(...items.map(([, v]) => Number(v)), 0) || 1;
const total = items.reduce((a, [, v]) => a + Number(v), 0) || 1;
const marked = new Set([].concat(mark));
const fmt = (n) => Number(n).toLocaleString('en-GB');
---
<figure class="bars reveal">
  <table aria-label={caption ?? label}>
    <thead>
      <tr>
        <th scope="col">{label}</th>
        <th scope="col" class="bars__numhead">{unit}</th>
        {share && <th scope="col" class="bars__numhead">Share</th>}
      </tr>
    </thead>
    <tbody>
      {items.map(([name, value, meta]) => (
        <tr data-mark={marked.has(name) ? '' : undefined}>
          <th scope="row">
            <span class="bars__name">{name}</span>
            {meta && <span class="bars__meta">{meta}</span>}
          </th>
          <td class="bars__cell">
            {/* aria-hidden: the number beside it already says this */}
            <span class="bars__track" aria-hidden="true">
              <span class="bars__fill" style={`width:${(Number(value) / max) * 100}%`}></span>
            </span>
            <span class="bars__value figure-num">{fmt(value)}</span>
          </td>
          {share && <td class="bars__share">{((Number(value) / total) * 100).toFixed(1)}%</td>}
        </tr>
      ))}
    </tbody>
  </table>
  {caption && <figcaption class="bars__cap meta">{caption}</figcaption>}
  {note && <p class="bars__note meta">{note}</p>}
</figure>

<style>
  /* Full column, so this lines up with the figures above and below it. */
  .bars { margin: var(--space-6) 0 0; max-width: none; }
  table { width: 100%; border-collapse: collapse; }

  thead th {
    font-size: var(--size-1);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-quiet);
    font-weight: var(--weight-normal);
    text-align: left;
    padding-bottom: var(--space-3);
    border-bottom: var(--border-hair) solid var(--rule);
  }
  .bars__numhead { text-align: right; }

  tbody th {
    font-weight: var(--weight-normal);
    text-align: left;
    vertical-align: baseline;
    padding: var(--space-3) var(--space-5) var(--space-3) 0;
    white-space: nowrap;
  }
  .bars__name { font-size: var(--size-3); }
  .bars__meta {
    display: block;
    font-size: var(--size-1);
    color: var(--ink-quiet);
    letter-spacing: 0;
    text-transform: none;
    white-space: normal;
  }

  .bars__cell {
    width: 100%;
    padding: var(--space-3) 0;
    vertical-align: baseline;
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
  }
  .bars__track {
    flex: 1;
    min-width: 0;
    height: 10px;
    /* A rule rather than a filled track: a grey trough behind every bar is
       dashboard furniture, and it makes the empty part look like data. */
    border-bottom: var(--border-hair) solid var(--rule);
    position: relative;
    top: -2px;
  }
  .bars__fill {
    display: block;
    height: 10px;
    background: var(--accent);
    /* Never vanishes: a row with one sample still has to be visible, because
       the thin rows are the ones the argument is about. */
    min-width: 2px;
  }
  .bars__value {
    font-size: var(--size-3);
    text-align: right;
    min-width: 4.5ch;
  }
  .bars__share {
    font-size: var(--size-2);
    color: var(--ink-quiet);
    text-align: right;
    padding: var(--space-3) 0 var(--space-3) var(--space-5);
    vertical-align: baseline;
    white-space: nowrap;
  }

  /* The marked row. Weight and a rule, not a second colour: the page already
     carries one accent and this has to stay readable in greyscale. */
  tr[data-mark] .bars__name { font-weight: var(--weight-bold); }
  tr[data-mark] .bars__value { font-weight: var(--weight-bold); }
  tr[data-mark] th { position: relative; }
  tr[data-mark] th::before {
    content: '';
    position: absolute;
    left: -10px;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 1em;
    background: var(--ink);
  }

  .bars__cap { margin-top: var(--space-4); max-width: var(--measure); }
  .bars__note { margin-top: var(--space-3); max-width: var(--measure); }

  @media (max-width: 560px) {
    tbody th { white-space: normal; padding-right: var(--space-4); }
    .bars__value { min-width: 0; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .bars__fill { transition: width var(--dur, 400ms) ease-out; }
  }
</style>
