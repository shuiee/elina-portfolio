---
/* Contact, laid out as one horizontal row. Icons are inline SVG so there is no
   file to load and they inherit the text colour. Each is aria-hidden — the link
   text already says where it goes. */
const links = [
  {
    href: 'mailto:elinahsyj@gmail.com',
    label: 'elinahsyj@gmail.com',
    icon: 'mail',
  },
  {
    href: 'https://linkedin.com/in/ejl25',
    label: 'linkedin.com/in/ejl25',
    icon: 'linkedin',
  },
  /* GitHub, taken down for now at Elina's request. The icon branch below is
     left in place, so putting it back is just uncommenting this block. */
  // {
  //   href: 'https://github.com/shuiee',
  //   label: 'github.com/shuiee',
  //   icon: 'github',
  // },
];
---
<footer class="site-footer">
  <div class="page">
    <hr />
    <ul class="site-footer__links">
      {links.map((l) => (
        <li>
          <a href={l.href} rel={l.href.startsWith('http') ? 'me' : undefined}>
            <span class="site-footer__icon" aria-hidden="true">
              {l.icon === 'mail' && (
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="4.5" width="20" height="15" rx="2" />
                  <path d="M2.6 6 12 13 21.4 6" />
                </svg>
              )}
              {l.icon === 'linkedin' && (
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                  <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
                </svg>
              )}
              {l.icon === 'github' && (
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                  <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z" />
                </svg>
              )}
            </span>
            <span>{l.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer { margin-top: var(--space-10); padding-bottom: var(--space-8); }
  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: var(--space-5) 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4) var(--space-7);
    font-size: var(--size-2);
  }
  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }
  .site-footer__links a:hover span:last-child { text-decoration: underline; }
  .site-footer__icon { display: inline-flex; color: var(--ink-quiet); }
</style>
