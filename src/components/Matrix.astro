---
/* A comparison matrix, treated as primary content rather than a supporting
   graphic. Marks are distinguished by SHAPE, not colour — the same reason the
   signage study recommends luminance contrast over colour accents. Each cell
   also carries a text label for screen readers.

   columns = ['BeReal', 'Day One', ...]
   rows    = [['Feature name', ['yes','no','partial', ...]], ...]
   gap     = the sentence stating what the matrix revealed
*/
const { columns = [], rows = [], caption, gap } = Astro.props;
const MARK = {
  yes:     { glyph: '✓', label: 'yes' },
  no:      { glyph: '✕', label: 'no' },
  partial: { glyph: '△', label: 'partial' },
};
---
<div class="matrix reveal">
  <div class="matrix__scroll">
    <table>
      {caption && <caption class="meta">{caption}</caption>}
      <thead>
        <tr>
          <th scope="col" class="matrix__corner">Feature</th>
          {columns.map((c) => <th scope="col">{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map(([feature, cells]) => (
          <tr>
            <th scope="row">{feature}</th>
            {cells.map((state) => (
              <td data-state={state}>
                <span aria-hidden="true" class="matrix__mark">{MARK[state].glyph}</span>
                <span class="sr-only">{MARK[state].label}</span>
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {gap && <p class="matrix__gap">{gap}</p>}
</div>

<style>
  .matrix { margin: var(--space-6) 0 0; }
  /* Wide content scrolls inside its own container; the page body never does. */
  .matrix__scroll { overflow-x: auto; background: var(--field); padding: var(--space-5); }
  table { border-collapse: collapse; width: 100%; min-width: 34rem; font-size: var(--size-2); }
  caption { text-align: left; padding-bottom: var(--space-4); }
  th, td { padding: var(--space-3) var(--space-2); text-align: center; }
  thead th {
    font-weight: var(--weight-bold);
    font-size: var(--size-1);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    border-bottom: var(--border-hair) solid var(--ink);
    vertical-align: bottom;
  }
  .matrix__corner, tbody th {
    text-align: left;
    font-weight: var(--weight-normal);
    min-width: 11rem;
    line-height: var(--leading-body);
  }
  tbody tr + tr th, tbody tr + tr td { border-top: var(--border-hair) solid var(--rule); }
  .matrix__mark { font-size: var(--size-5); line-height: 1; }
  td[data-state='partial'] .matrix__mark { color: var(--accent-ink); }
  .matrix__gap {
    margin-top: var(--space-5);
    max-width: var(--measure);
    font-size: var(--size-4);
  }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
</style>
