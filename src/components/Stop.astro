---
/* One stop on the Route. `label` is the stop marker ("Stop 01", "Terminus"),
   `title` the stage of work. Deliberately not a .reveal: the bus already
   supplies the motion on this page, and a stop that starts at opacity 0 would
   be unreadable in the still frame a reader lands on. */
const { label, title, href } = Astro.props;
---
<li class="stop" data-stop>
  <div class="stop__head">
    <span class="figure-num stop__label">{label}</span>
    <h3 class="stop__title">
      {href ? <a href={href}>{title}</a> : title}
    </h3>
  </div>
  <div class="stop__body"><slot /></div>
  {href && (
    <p class="stop__more">
      <a href={href}>Read in detail <span aria-hidden="true">&darr;</span></a>
    </p>
  )}
</li>

<style>
  .stop {
    background: var(--field);
    border: var(--border-hair) solid var(--rule);
    padding: var(--space-5) var(--space-6);
    transition: border-color var(--motion-base) var(--motion-ease),
                box-shadow var(--motion-base) var(--motion-ease);
  }
  /* The bus is passing this stop. An outline rather than a fill, so the body
     text keeps the same ground and the same contrast wherever the bus is. */
  .stop.is-here {
    border-color: var(--accent-ink);
    box-shadow: 0 0 0 var(--border-hair) var(--accent-ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .stop { transition: none; }
  }

  .stop__head {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    flex-wrap: wrap;
  }
  .stop__label {
    font-size: var(--size-1);
    color: var(--accent-ink);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    flex: none;
  }
  .stop__title { font-size: var(--size-4); margin: 0; }
  /* A stop that stands for a section further down the page. The whole stop is
     not a link: the summary inside it is readable content, and wrapping a
     paragraph in an anchor would make it one enormous click target. */
  .stop__title a { text-decoration: none; }
  .stop__title a:hover { text-decoration: underline; }
  .stop__more {
    margin-top: var(--space-4);
    font-size: var(--size-1);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }
  .stop__more a { color: var(--accent-ink); }
  .stop__body { margin-top: var(--space-4); }
  .stop__body > * + * { margin-top: var(--space-4); }
  .stop__body p { max-width: var(--measure); }


</style>
