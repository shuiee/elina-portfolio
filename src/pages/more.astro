---
/* The "More" page. Elina asked on 2026-11-27 for the CV to come off it while
   she decides what this page is actually for, so it is deliberately a title
   and nothing else. Nothing has been invented to fill it.

   The CV that used to be here — education, design projects, professional
   experience and the skills table, with all its data — is in git. To bring any
   of it back:  git show 1159216:src/pages/more.astro

   /cv/ still redirects here (see astro.config.mjs), so no old link is broken. */
import Base from '../layouts/Base.astro';
---
<Base title="More" description="More from Elina J. Lee.">
  <div class="page more">
    <header class="more__head">
      <h1 class="script more__title">More</h1>
    </header>
  </div>
</Base>

<style>
  /* Same padding and same container as About and Work, so the three page
     titles land on the same left edge at the same height and the column they
     open is the same width. The page used to cap itself at 60rem, which made
     "more" sit in a narrower column than "about" and "work". */
  .more { padding-top: var(--space-7); }
  .more__title {
    font-size: clamp(var(--size-8), 9vw, var(--size-10));
    line-height: 0.95;
    letter-spacing: -0.01em;
    margin-top: var(--space-4);
  }
</style>
