---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url.js';
---
<Base title="Not found" description="That page does not exist.">
  <div class="page nf">
    <p class="figure-num nf__code">404</p>
    <h1>That page does not exist.</h1>
    <p class="nf__body">
      The link is either out of date or mistyped. Everything on this site is reachable
      from <a href={href('/work/')}>the work index</a>.
    </p>
  </div>
</Base>

<style>
  .nf { padding-block: var(--space-9) var(--space-10); }
  .nf__code { font-size: var(--size-8); line-height: 1; color: var(--ink-quiet); }
  .nf h1 { font-size: var(--size-7); margin: var(--space-4) 0; max-width: 20ch; }
  .nf__body { max-width: var(--measure); }
</style>
