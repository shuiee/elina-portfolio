---
/* The contents page. Since the landing page no longer lists projects, this is
   where a reader meets all four for the first time — so each entry carries the
   instrument, not just a title. */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { href, asset } from '../../lib/url.js';
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Work" description="Five investigations in problem framing.">
  <div class="page wk">
    <header class="wk__head">
      <p class="corner"><span class="figure-num">02</span> Work</p>
      <h1 class="script wk__title">Work</h1>
    </header>

    <ol class="wk__list">
      {work.map((p) => (
        <li class="wk__item reveal" data-accent={p.data.accent}>
          <div class="wk__id">
            <a class="wk__link" href={href(`/work/${p.id}/`)}>
              <span class="figure-num wk__num">{p.data.number}</span>
              <span class="wk__name">{p.data.title}</span>
            </a>
            <p class="meta wk__meta">
              {p.data.dates}<br />{p.data.projectType}<br />{p.data.role}
            </p>
          </div>

          <div class="wk__case">
            <a class="wk__peek" href={href(`/work/${p.id}/`)} tabindex="-1" aria-hidden="true">
              {p.data.thumb ? (
                <img src={asset(p.data.thumb)} alt="" width="1280" height="720" loading="lazy" />
              ) : (
                <span class="wk__peek-empty"><span class="eyebrow">Image to come</span></span>
              )}
            </a>

            <p class="wk__about">{p.data.about}</p>
            <p class="wk__q">{p.data.question}</p>

            <dl class="wk__facets">
              {p.data.concepts.length > 0 && (
                <div class="wk__facet">
                  <dt class="eyebrow">Concepts</dt>
                  <dd>{p.data.concepts.join(' · ')}</dd>
                </div>
              )}
              {p.data.skills.length > 0 && (
                <div class="wk__facet">
                  <dt class="eyebrow">Skills</dt>
                  <dd>{p.data.skills.join(' · ')}</dd>
                </div>
              )}
              {p.data.tools.length > 0 && (
                <div class="wk__facet">
                  <dt class="eyebrow">Tools</dt>
                  <dd>{p.data.tools.join(' · ')}</dd>
                </div>
              )}
            </dl>

            <a class="wk__more" href={href(`/work/${p.id}/`)}>
              Read the full project <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .wk { padding-top: var(--space-7); }
  .wk__head { padding-bottom: var(--space-7); }
  .wk__title {
    font-size: clamp(var(--size-8), 9vw, var(--size-10));
    line-height: 0.95;
    margin: var(--space-4) 0 0;
    letter-spacing: -0.01em;
  }

  .wk__list { list-style: none; padding: 0; margin: 0; }
  .wk__item {
    padding-block: var(--space-8);
    border-top: var(--border-hair) solid var(--rule);
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 950px) {
    .wk__item {
      grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
  }
  .wk__link { display: flex; gap: var(--space-4); align-items: baseline; text-decoration: none; }
  .wk__link:hover .wk__name { text-decoration: underline; }
  .wk__num { font-size: var(--size-6); color: var(--accent-ink); flex: none; }
  .wk__name {
    font-size: var(--size-6);
    font-weight: var(--weight-bold);
    line-height: var(--leading-head);
    letter-spacing: var(--track-head);
  }
  .wk__meta { margin-top: var(--space-4); }

  .wk__case { min-width: 0; }

  /* The preview. Decorative and aria-hidden: the title next to it is already a
     link to the same place, so a screen reader should not hear it twice. The
     alt text for each image lives in the thumbAlt frontmatter field, ready for
     when one of these becomes a content image rather than a teaser. */
  .wk__peek {
    display: block;
    margin-bottom: var(--space-6);
    background: var(--field);
    border-top: var(--border-mark) solid var(--accent);
  }
  .wk__peek img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .wk__peek-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    border: var(--border-hair) dashed var(--rule);
    border-top: 0;
  }
  /* What the project is, first — plain text on the page, no container.
     A white sheet is reserved for an actual exhibit (a matrix, a marking
     scheme); wrapping a two-line description in one adds weight without
     adding information. The project's colour survives on the number. */
  .wk__about {
    font-size: var(--size-5);
    line-height: var(--leading-body);
    text-wrap: pretty;
  }

  /* Then the question, in the written half — it is her voice, so it is set in
     the same italic that opens the project page itself. */
  /* No max-width: the question fills the same column as the panel above it, so
     both blocks end on the same right margin. */
  .wk__q {
    margin-top: var(--space-6);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--size-6);
    line-height: 1.15;
  }
  /* What the project explores, what it took, and what it was made with.
     Labelled rows rather than tag pills: these are sentences worth reading, not
     keywords to be scanned and forgotten. */
  .wk__facets {
    margin: var(--space-6) 0 0;
    padding-top: var(--space-5);
    border-top: var(--border-hair) solid var(--rule);
    display: grid;
    gap: var(--space-4);
  }
  .wk__facet { display: grid; gap: var(--space-1); }
  @media (min-width: 700px) {
    .wk__facet { grid-template-columns: 5.5rem minmax(0, 1fr); gap: var(--space-5); }
  }
  .wk__facet dt { padding-top: 0.3em; }
  .wk__facet dd { margin: 0; font-size: var(--size-3); line-height: var(--leading-body); }

  .wk__more { display: inline-block; margin-top: var(--space-6); font-weight: var(--weight-med); }
</style>
