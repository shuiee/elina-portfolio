---
/* The contents page, as a wall of identical tiles.
 *
 * The image leads. A reader should be able to tell what a project LOOKS like
 * before they read a word about it, then get the name, then one short
 * description. Everything else — concepts, skills, tools, the framing question
 * — now lives on the project page, where there is room to mean something. On
 * this page they were five stacked metadata rows per entry, which is what was
 * pushing the images off the screen in the first place.
 *
 * Every tile is the same size: two equal columns, one ratio, three rows. The
 * uniformity is the design. There is no arrangement to configure here, and
 * that is deliberate — a project is added by dropping an .mdx file in, and the
 * wall stays regular on its own.
 *
 * What varies is inside the frame, not the frame. Most of these projects are
 * diagrams, slides and screenshots rather than photographs, so the default
 * treatment mounts the artwork on a muted ground mixed from the project's own
 * accent (thumbFit: mount). A photograph good enough to carry a whole tile
 * gets thumbFit: bleed in its frontmatter and fills the frame instead.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { href, asset } from '../../lib/url.js';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Work" description="Six projects in problem framing.">
  <div class="page wk">
    <header class="wk__head">
      <p class="corner"><span class="figure-num">02</span> Work</p>
      <h1 class="script wk__title">Work</h1>
    </header>

    <ol class="wk__wall">
      {work.map((p) => (
        <li class="wk__tile reveal" data-accent={p.data.accent}>
          <div class={`wk__frame wk__frame--${p.data.thumbFit}`}>
            {p.data.thumb ? (
              <img
                class="wk__img"
                src={asset(p.data.thumb)}
                alt={p.data.thumbAlt ?? ''}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <p class="wk__missing">TODO(elina): no image for this project yet</p>
            )}
          </div>

          {/* The link wraps the title only, and a stretched pseudo-element
              carries the click across the whole tile. That way a screen reader
              announces "01 Seeing Information in Transport Systems" rather than
              the title plus the entire image description, and the image keeps
              its own alt text where it belongs. */}
          <h2 class="wk__name">
            <span class="figure-num wk__num">{p.data.number}</span>
            <a class="wk__link" href={href(`/work/${p.id}/`)}>{p.data.title}</a>
          </h2>

          <p class="wk__about">{p.data.about}</p>
          <p class="wk__meta">{p.data.projectType} · {p.data.dates}</p>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .wk { padding-top: var(--space-7); }
  .wk__head { padding-bottom: var(--space-8); }
  .wk__title {
    font-size: clamp(var(--size-8), 9vw, var(--size-10));
    line-height: 0.95;
    margin: var(--space-4) 0 0;
    letter-spacing: -0.01em;
  }

  /* ------------------------------------------------------------- the wall */
  .wk__wall {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-5);
    row-gap: var(--space-7);
  }
  @media (max-width: 599px) {
    .wk__wall { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-6); }
  }

  .wk__tile { position: relative; min-width: 0; }

  /* ------------------------------------------------------------ the frame
     Identical for every project: same ratio, same width, same hairline. The
     ground is the project accent mixed down into the page, so the six tiles
     are quietly six different colours without any of them shouting. */
  .wk__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--shape-tile);
    border: var(--border-hair) solid var(--rule);
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--accent) var(--mount-tint), var(--paper));
  }

  /* Mounted: the artwork sits on the ground at about three-quarters width,
     whatever shape it really is, so a panorama and a phone screen can share a
     wall without either being cropped.

     It is positioned out of flow on purpose. If it stayed in flow, a tall
     image would stretch its own frame and the wall would stop being uniform —
     which is the whole point of the wall. Out of flow, the frame's height
     comes from the ratio alone and the artwork can only ever fit inside it. */
  .wk__frame--mount .wk__img {
    position: absolute;
    top: 50%;
    left: 50%;
    width: auto;
    height: auto;
    max-width: var(--mount-scale);
    max-height: var(--mount-scale-h);
    /* A filter, not a box-shadow — half of these are cut-outs, and the shadow
       has to fall off the structure rather than off the image's rectangle.
       No border-radius either: it would round the invisible box, not the
       artwork, and the rectangular thumbnails carry their own edges. */
    filter: var(--shadow-mount);
    transform: translate(-50%, -50%);
  }
  .wk__tile:hover .wk__frame--mount .wk__img {
    transform: translate(-50%, -50%) scale(1.015);
  }

  /* Bleed: a photograph good enough to fill the frame on its own. */
  .wk__frame--bleed { background: var(--field); }
  .wk__frame--bleed .wk__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .wk__tile:hover .wk__frame--bleed .wk__img { transform: scale(1.015); }

  .wk__img {
    display: block;
    transition: transform var(--motion-base) var(--motion-ease);
  }

  .wk__missing {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    margin: 0;
    padding: var(--space-5);
    text-align: center;
    font-size: var(--size-2);
    color: var(--ink-quiet);
  }

  /* ---------------------------------------------------------- the caption
     Small on purpose. The image is the thing being looked at; the name and the
     two lines under it are for the reader who has already stopped. Title and
     description are the same size and separate on weight and colour, which is
     what keeps the block quiet enough to sit under a picture. */
  .wk__name {
    margin: var(--space-3) 0 0;
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    font-size: var(--size-3);
    font-weight: var(--weight-med);
    line-height: var(--leading-head);
    letter-spacing: 0;
  }

  .wk__num {
    flex: none;
    font-size: var(--size-2);
    font-weight: var(--weight-normal);
    color: var(--accent-ink);
  }

  .wk__link { color: inherit; text-decoration: none; }
  /* Stretched target: the whole tile is clickable, the accessible name is
     still just the project title. */
  .wk__link::after { content: ''; position: absolute; inset: 0; }
  .wk__tile:hover .wk__link {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .wk__about {
    margin: var(--space-2) 0 0;
    max-width: 44ch;
    font-size: var(--size-3);
    line-height: var(--leading-body);
    text-wrap: pretty;
  }

  .wk__meta {
    margin: var(--space-2) 0 0;
    font-size: var(--size-2);
    color: var(--ink-quiet);
  }

  @media (prefers-reduced-motion: reduce) {
    .wk__img { transition: none; }
    .wk__tile:hover .wk__frame--mount .wk__img { transform: translate(-50%, -50%); }
    .wk__tile:hover .wk__frame--bleed .wk__img { transform: none; }
  }
</style>
