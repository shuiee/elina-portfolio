---
import Base from '../layouts/Base.astro';
import { asset } from '../lib/url.js';

/* The submitted PDF, as click-through slides.
   Rendered to images rather than served as the PDF: the file is 44 MB, and
   nobody should pay that just to look through eighteen pages. */
const COUNT = 18;
const slides = Array.from({ length: COUNT }, (_, i) => {
  const n = String(i + 1).padStart(2, '0');
  return { n, src: `/portfolio/page-${n}.jpg` };
});
---
<Base title="Portfolio" description="The PDF portfolio, December 2025.">
  <div class="page pf">
    <p class="corner"><span class="figure-num">04</span> Portfolio</p>

    {/* Every slide is in the page. The script hides all but the current one;
        without it they simply stack and can be scrolled, which is a perfectly
        good way to read a deck. */}
    <div class="pf__deck" id="deck" data-count={COUNT}>
      <ol class="pf__slides">
        {slides.map((s, i) => (
          <li class="pf__slide" data-index={i}>
            <img
              src={asset(s.src)}
              alt={`Portfolio page ${i + 1} of ${COUNT}`}
              width="1800"
              height="1012"
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </li>
        ))}
      </ol>

      <div class="pf__controls" hidden>
        <button type="button" class="pf__nav" data-step="-1" aria-label="Previous page">
          <span aria-hidden="true">&larr;</span>
        </button>
        <p class="pf__count" aria-live="polite">
          <span class="figure-num" id="deck-current">01</span>
          <span class="pf__of">/</span>
          <span class="figure-num">{COUNT}</span>
        </p>
        <button type="button" class="pf__nav" data-step="1" aria-label="Next page">
          <span aria-hidden="true">&rarr;</span>
        </button>
      </div>
    </div>

    <p class="pf__caption meta">PDF Portfolio (Dec 2025)</p>
  </div>
</Base>

<style>
  .pf { padding-top: var(--space-7); max-width: 1100px; }
  .pf .corner { margin-bottom: var(--space-5); }

  .pf__slides { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-5); }
  .pf__slide img {
    width: 100%;
    height: auto;
    display: block;
    background: var(--field);
  }

  /* Single-slide mode, switched on by the script. */
  .pf__deck.is-live .pf__slides { display: block; gap: 0; }
  .pf__deck.is-live .pf__slide { display: none; }
  .pf__deck.is-live .pf__slide.is-current { display: block; }
  .pf__deck.is-live .pf__slide img { cursor: inherit; }

  .pf__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }
  .pf__nav {
    font: inherit;
    font-size: var(--size-5);
    line-height: 1;
    background: none;
    border: 0;
    padding: var(--space-2) var(--space-3);
    color: var(--ink);
  }
  .pf__nav[disabled] { color: var(--rule); }
  .pf__count {
    font-size: var(--size-2);
    letter-spacing: var(--track-label);
    display: flex;
    gap: var(--space-2);
    color: var(--ink-quiet);
  }
  .pf__of { opacity: 1; }

  .pf__caption { margin-top: var(--space-5); text-align: center; }
</style>

<script>
  /* Click-through deck. The slides are already in the page; this only decides
     which one is on screen. If it never runs, all eighteen stack and scroll. */
  const deck = document.getElementById('deck');

  if (deck) {
    const slides = [...deck.querySelectorAll('.pf__slide')];
    const controls = deck.querySelector('.pf__controls');
    const counter = document.getElementById('deck-current');
    const buttons = [...deck.querySelectorAll('.pf__nav')];
    let index = 0;

    deck.classList.add('is-live');
    controls.hidden = false;

    function show(next) {
      index = Math.min(Math.max(next, 0), slides.length - 1);
      slides.forEach((s, i) => s.classList.toggle('is-current', i === index));
      counter.textContent = String(index + 1).padStart(2, '0');
      buttons.forEach((b) => {
        const step = Number(b.dataset.step);
        b.disabled = step < 0 ? index === 0 : index === slides.length - 1;
      });
      /* Load the neighbour eagerly so the next click is instant. */
      const ahead = slides[index + 1]?.querySelector('img');
      if (ahead) ahead.loading = 'eager';
    }

    buttons.forEach((b) => b.addEventListener('click', () => show(index + Number(b.dataset.step))));

    /* Clicking the slide advances; the last one wraps back to the start so the
       deck can be read round more than once without hunting for a button. */
    deck.querySelector('.pf__slides').addEventListener('click', () => {
      show(index === slides.length - 1 ? 0 : index + 1);
    });

    document.addEventListener('keydown', (event) => {
      if (event.target instanceof HTMLInputElement) return;
      if (event.key === 'ArrowRight') show(index + 1);
      if (event.key === 'ArrowLeft') show(index - 1);
    });

    show(0);
  }
</script>
