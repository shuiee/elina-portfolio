---
/* The landing page is a title page, not a contents page. It says who she is and
   what the argument is, and sends the reader to /work/. The four projects live
   there — repeating them here would make the visitor choose before they have
   been told anything. */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { href, asset } from '../lib/url.js';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<Base description="Engineer. I design the measurement before I design the thing.">
  <div class="page landing">

    <h1 class="landing__name">
      <span class="landing__full">Elina J. Lee</span>
    </h1>

    <div class="landing__thesis">
      <div class="landing__centre">
        <p class="landing__claim">
          I&rsquo;m an engineer that likes finding structure<br />in creativity, and creativity in structure.
        </p>
        <img
          class="landing__portrait"
          src={asset('/images/elina-portrait.png')}
          alt="Ink drawing of Elina, from the cover of her portfolio."
          width="900"
          height="970"
        />
      </div>

    </div>


    <nav class="landing__contents" aria-label="Contents">
      <ol>
        {work.map((p) => (
          <li>
            <a href={href(`/work/${p.id}/`)}>
              <span class="figure-num landing__contents-num">{p.data.number}</span>
              <span class="landing__contents-title">{p.data.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <p class="landing__enter">
      <a href={href('/work/')}>
        See my work <span aria-hidden="true">&rarr;</span>
      </a>
    </p>

  </div>
</Base>

<style>
  /* The landing page runs wider than the rest of the site so the name can fill
     the measure and the two notes can sit out near the edges, as on the
     reference. Every other page keeps --page-max. */
  .landing {
    max-width: 1600px;
    padding-top: var(--space-5);
    padding-bottom: var(--space-7);
  }

  /* -- the name ----------------------------------------------------------- */
  .landing__name {
    margin: var(--space-5) 0 var(--space-6);
    text-align: center;
    line-height: 0.9;
    letter-spacing: var(--track-head);
    /* Sized off the viewport so it always fills the line, capped so it cannot
       run away on a very wide monitor. */
    font-size: clamp(var(--size-8), 15.6vw, var(--size-11));
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.04em;
  }

  /* The name is set in one face. The written half lives on the page titles and
     on the question that opens each case study, not on her own name. */
  .landing__full {
    font-weight: var(--weight-bold);
    letter-spacing: -0.035em;
  }

  /* -- the claim, flanked by two notes ------------------------------------ */
  .landing__thesis {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .landing__centre { display: grid; justify-items: center; gap: var(--space-5); }

  /* The drawing from the cover of the portfolio deck, keyed to transparency so
     the page ground shows through the face rather than a white box. */
  .landing__portrait {
    width: clamp(104px, 12vw, 150px);
    height: auto;
  }

  .landing__claim {
    font-size: var(--size-5);
    font-weight: var(--weight-bold);
    line-height: var(--leading-head);
    letter-spacing: var(--track-head);
    text-wrap: balance;
  }
  @media (min-width: 700px) { .landing__claim { font-size: var(--size-6); } }

  /* -- enter + footnote --------------------------------------------------- */
  .landing__enter {
    margin: var(--space-6) 0 0;
    text-align: center;
    font-size: var(--size-5);
  }
  .landing__enter a {
    text-decoration-thickness: var(--border-hair);
    text-underline-offset: 0.3em;
  }
  /* A quiet contents list. Set in --ink-quiet so it recedes behind the name and
     the tagline, but that is still 7.72:1 — quiet, never unreadable. */
  /* A quiet contents list, centred, in the same all-caps letterspaced style the
     side notes used. --ink-quiet is 7.72:1, so it recedes without being faint. */
  .landing__contents {
    margin: 0;
    padding-top: var(--space-7);
    width: 100%;
  }
  .landing__contents ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    text-align: center;
  }
  .landing__contents a {
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--ink-quiet);
    font-size: var(--size-1);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    line-height: 1.5;
  }
  .landing__contents a:hover { color: var(--ink); }
  .landing__contents a:hover .landing__contents-title { text-decoration: underline; }
  .landing__contents-num { flex: none; letter-spacing: 0; }
</style>
