---
/* The landing page is a title page, not a contents page. It says who she is and
   what the argument is, and sends the reader to /work/. The four projects live
   there — repeating them here would make the visitor choose before they have
   been told anything. */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { href, asset } from '../lib/url.js';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<Base description="Engineer. I design the measurement before I design the thing.">
  <div class="page landing">

    <h1 class="landing__name">
      <span class="landing__full">Elina J. Lee</span>
    </h1>

    <p class="landing__claim">
      I&rsquo;m an engineer that likes finding structure<br />in creativity, and creativity in structure.
    </p>

    {/* The drawing with the projects orbiting it. Without JavaScript this is a
        plain centred list under the portrait, which is what it degrades to —
        the circular placement and the dragging are both added by script. */}
    <div class="stage" id="stage">
      <img
        class="stage__portrait"
        src={asset('/images/elina-portrait.png')}
        alt="Ink drawing of Elina, from the cover of her portfolio."
        width="900"
        height="970"
      />

      <nav class="stage__contents" aria-label="Contents">
        <ol>
          {work.map((p) => (
            <li class="orbit">
              <a href={href(`/work/${p.id}/`)} draggable="false">
                <span class="figure-num orbit__num">{p.data.number}</span>
                <span class="orbit__title">{p.data.shortTitle}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>

    <p class="landing__enter">
      <a href={href('/work/')}>
        See my work <span aria-hidden="true">&rarr;</span>
      </a>
    </p>

  </div>
</Base>

<style>
  /* The landing page runs wider than the rest of the site so the name can fill
     the measure and the two notes can sit out near the edges, as on the
     reference. Every other page keeps --page-max. */
  .landing {
    max-width: 1600px;
    padding-top: var(--space-5);
    padding-bottom: var(--space-7);
  }

  /* -- the name ----------------------------------------------------------- */
  .landing__name {
    margin: var(--space-5) 0 var(--space-6);
    text-align: center;
    line-height: 0.9;
    letter-spacing: var(--track-head);
    /* Sized off the viewport so it always fills the line, capped so it cannot
       run away on a very wide monitor. */
    font-size: clamp(var(--size-8), 15.6vw, var(--size-11));
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.04em;
  }

  /* The name is set in one face. The written half lives on the page titles and
     on the question that opens each case study, not on her own name. */
  .landing__full {
    font-weight: var(--weight-bold);
    letter-spacing: -0.035em;
  }

  /* -- the claim, flanked by two notes ------------------------------------ */
  .landing__claim {
    font-size: var(--size-5);
    font-weight: var(--weight-bold);
    line-height: var(--leading-head);
    letter-spacing: var(--track-head);
    text-align: center;
    text-wrap: balance;
    margin-inline: auto;
  }
  @media (min-width: 700px) { .landing__claim { font-size: var(--size-6); } }

  /* ---------------------------------------------------------------- stage
     The portrait sits in the middle; the projects are placed around it by
     script and can then be dragged anywhere. The stage is the drag boundary. */
  .stage {
    position: relative;
    margin: var(--space-6) auto 0;
    width: 100%;
    display: grid;
    justify-items: center;
    gap: var(--space-5);
  }

  .stage__portrait {
    width: clamp(116px, 13vw, 168px);
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }

  .stage__contents ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    text-align: center;
  }

  .orbit a {
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--ink-quiet);
    font-size: var(--size-1);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    line-height: 1.5;
  }
  .orbit a:hover { color: var(--ink); }
  .orbit a:hover .orbit__title { text-decoration: underline; }
  .orbit__num { flex: none; letter-spacing: 0; }

  /* Applied by script once the projects have been placed in a circle. From
     here on the stage is a positioned canvas rather than a stacked list. */
  .stage.is-orbiting { display: block; height: var(--stage-h, 520px); }
  .stage.is-orbiting .stage__portrait {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .stage.is-orbiting .stage__contents ol { display: block; }
  .stage.is-orbiting .orbit {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(-50%, -50%);
    touch-action: none;
    white-space: nowrap;
  }
  .stage.is-orbiting .orbit a { cursor: inherit; }
  .stage.is-orbiting .orbit.is-dragging { z-index: 2; }
  .stage.is-orbiting .orbit.is-dragging a { color: var(--ink); }

  .landing__enter {
    margin: var(--space-6) 0 0;
    text-align: center;
    font-size: var(--size-5);
  }
  .landing__enter a {
    text-decoration-thickness: var(--border-hair);
    text-underline-offset: 0.3em;
  }
  /* A quiet contents list. Set in --ink-quiet so it recedes behind the name and
     the tagline, but that is still 7.72:1 — quiet, never unreadable. */
  /* A quiet contents list, centred, in the same all-caps letterspaced style the
     side notes used. --ink-quiet is 7.72:1, so it recedes without being faint. */
  .landing__contents {
    margin: 0;
    padding-top: var(--space-7);
    width: 100%;
  }
  .landing__contents ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    text-align: center;
  }
  .landing__contents a {
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--ink-quiet);
    font-size: var(--size-1);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    line-height: 1.5;
  }
  .landing__contents a:hover { color: var(--ink); }
  .landing__contents a:hover .landing__contents-title { text-decoration: underline; }
  .landing__contents-num { flex: none; letter-spacing: 0; }
</style>

<script>
  /* The projects orbit the drawing, and can be dragged anywhere on the stage.
     Both are enhancements: the markup is a plain list of links, and if this
     script never runs the page is still a readable, clickable contents list.

     Two rules make the dragging behave:
       - a pointer that moves less than a few pixels is a CLICK, so the link
         still navigates; anything further is a drag and the click is suppressed
       - an item that has been dragged is never repositioned by a later resize,
         because the reader put it there on purpose */
  const stage = document.getElementById('stage');

  if (stage) {
    const items = [...stage.querySelectorAll('.orbit')];
    const MIN_WIDTH = 760;   // below this the circle is not worth attempting
    const THRESHOLD = 4;     // px of travel before a press counts as a drag

    function layout() {
      if (window.innerWidth < MIN_WIDTH) {
        stage.classList.remove('is-orbiting');
        stage.style.removeProperty('--stage-h');
        items.forEach((el) => {
          el.style.left = '';
          el.style.top = '';
          delete el.dataset.moved;
        });
        return;
      }

      const h = Math.round(Math.min(500, Math.max(420, window.innerWidth * 0.36)));
      stage.style.setProperty('--stage-h', h + 'px');
      stage.classList.add('is-orbiting');

      const w = stage.clientWidth;
      const cx = w / 2;
      const cy = h / 2;
      const r = Math.min(215, h / 2 - 40, w / 2 - 160);

      items.forEach((el, i) => {
        if (el.dataset.moved) return;
        const angle = -Math.PI / 2 + (i * 2 * Math.PI) / items.length;
        el.style.left = cx + r * Math.cos(angle) + 'px';
        el.style.top = cy + r * Math.sin(angle) + 'px';
      });
    }

    layout();
    window.addEventListener('resize', layout);

    items.forEach((el) => {
      const link = el.querySelector('a');
      let startX = 0, startY = 0, originX = 0, originY = 0;
      let dragging = false, moved = false;

      el.addEventListener('pointerdown', (event) => {
        if (!stage.classList.contains('is-orbiting')) return;
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        dragging = true;
        moved = false;
        startX = event.clientX;
        startY = event.clientY;
        originX = parseFloat(el.style.left) || 0;
        originY = parseFloat(el.style.top) || 0;
        /* Capture keeps the drag alive if the pointer outruns the element.
           It can throw if the pointer is already gone, which must not take the
           drag down with it. */
        try { el.setPointerCapture(event.pointerId); } catch (e) { /* no active pointer */ }
        el.classList.add('is-dragging');
      });

      el.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        const dx = event.clientX - startX;
        const dy = event.clientY - startY;
        if (!moved && Math.hypot(dx, dy) > THRESHOLD) moved = true;
        if (!moved) return;
        event.preventDefault();
        const w = stage.clientWidth;
        const h = stage.clientHeight;
        el.style.left = Math.min(Math.max(originX + dx, 12), w - 12) + 'px';
        el.style.top = Math.min(Math.max(originY + dy, 12), h - 12) + 'px';
      });

      function release(event) {
        if (!dragging) return;
        dragging = false;
        el.classList.remove('is-dragging');
        try { el.releasePointerCapture(event.pointerId); } catch (e) { /* already released */ }
        if (moved) el.dataset.moved = 'true';
      }

      el.addEventListener('pointerup', release);
      el.addEventListener('pointercancel', release);

      /* A drag that finishes on the link must not also open it. */
      link.addEventListener('click', (event) => {
        if (moved) {
          event.preventDefault();
          moved = false;
        }
      });
      link.addEventListener('dragstart', (event) => event.preventDefault());
    });
  }
</script>
