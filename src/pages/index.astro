---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { href } from '../lib/url.js';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<Base description="Engineer. I design the measurement before I design the thing.">
  <div class="page">

    <section class="hero">
      <h1 class="hero__thesis">I design the measurement before I design the thing.</h1>
      <p class="hero__proof">
        Four projects. In each one there is a moment where I stop and define what
        &ldquo;good&rdquo; would mean, in terms someone else could argue with. A marking
        scheme for misremembered station names. A feature matrix across seven platforms.
        A sensitivity band. Five criteria agreed before anyone drew anything. Those
        moments are what this site shows.
      </p>
    </section>

    <hr />

    <ol class="work-list">
      {work.map((p) => (
        <li class="work-item reveal" data-accent={p.data.accent}>
          <div class="work-item__id">
            <a class="work-item__link" href={href(`/work/${p.id}/`)}>
              <span class="figure-num work-item__num">{p.data.number}</span>
              <span class="work-item__title">{p.data.title}</span>
            </a>
            <p class="meta work-item__meta">{p.data.dates}<br />{p.data.projectType}<br />{p.data.role}</p>
          </div>

          <div class="work-item__case">
            <div class="work-item__instrument">
              <p class="eyebrow">The instrument</p>
              <p class="work-item__instrument-text">{p.data.instrument}</p>
            </div>

            <p class="work-item__q">{p.data.question}</p>

            <a class="work-item__more" href={href(`/work/${p.id}/`)}>
              Read case study {p.data.number} <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </li>
      ))}
    </ol>

  </div>
</Base>

<style>
  .hero { padding-block: var(--space-9) var(--space-8); }
  .hero__thesis {
    font-size: var(--size-8);
    max-width: var(--measure-lede);
  }
  @media (min-width: 800px) { .hero__thesis { font-size: var(--size-9); } }
  .hero__proof {
    margin-top: var(--space-6);
    font-size: var(--size-5);
    max-width: var(--measure);
    line-height: var(--leading-loose);
  }

  .work-list { list-style: none; padding: 0; margin: 0; }
  .work-item {
    padding-block: var(--space-8);
    border-bottom: var(--border-hair) solid var(--rule);
    display: grid;
    gap: var(--space-5);
  }
  /* Two columns from 950px: identity on the left, the argument on the right.
     Below that they stack in the same reading order. */
  @media (min-width: 950px) {
    .work-item {
      grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
  }
  .work-item__link {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    text-decoration: none;
  }
  .work-item__link:hover .work-item__title { text-decoration: underline; }
  .work-item__num { font-size: var(--size-6); color: var(--accent-ink); flex: none; }
  .work-item__title {
    /* size-6, not size-7: the big scale belongs to the case study page. */
    font-size: var(--size-6);
    font-weight: var(--weight-bold);
    line-height: var(--leading-head);
    letter-spacing: var(--track-head);
  }
  .work-item__meta { margin-top: var(--space-4); }

  .work-item__instrument {
    background: var(--field);
    border-top: var(--border-mark) solid var(--accent);
    padding: var(--space-5) var(--space-6) var(--space-6);
  }
  .work-item__instrument-text {
    margin-top: var(--space-2);
    font-size: var(--size-5);
    line-height: var(--leading-head);
    text-wrap: pretty;
  }

  .work-item__q {
    margin-top: var(--space-5);
    max-width: var(--measure);
    color: var(--ink-quiet);
  }
  .work-item__case { min-width: 0; }
  .work-item__more {
    display: inline-block;
    margin-top: var(--space-5);
    font-weight: var(--weight-med);
    text-decoration-thickness: var(--border-hair);
  }
</style>
