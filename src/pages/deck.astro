---
import Base from '../layouts/Base.astro';
import { asset, href } from '../lib/url.js';

/* The submitted PDF, kept as a fixed record. Deliberately NOT embedded in an
   iframe: it is 44 MB, and nobody should download that just for arriving on
   the page. The cover image stands in for it, and the reader chooses. */
const pdf = '/deck/elina-lee-portfolio-2025.pdf';
const pages = 18;
const size = '44 MB';
---
<Base title="Deck" description="The portfolio deck submitted with Elina's Harvard MDE application.">
  <div class="page deck">
    <header class="deck__head">
      <p class="corner"><span class="figure-num">04</span> Deck</p>
      <h1 class="script deck__title">Deck</h1>
      <p class="deck__intro">
        The PDF portfolio I submitted with my Harvard application. It is kept here
        unchanged, as a record of where the work stood at that point. The project
        pages on this site are newer and go further; this is the version that was
        handed in.
      </p>
      <p class="meta deck__todo">
        TODO(elina): confirm this is the file you submitted, and the month it went in.
        The filename and the line above both say 2025.
      </p>
    </header>

    <a class="deck__cover" href={asset(pdf)} target="_blank" rel="noopener">
      <img
        src={asset('/images/deck-cover.jpg')}
        alt="Cover of the portfolio deck: the title page with the contents of the four projects."
        width="1600"
        height="900"
      />
    </a>

    <div class="deck__actions">
      <a class="deck__open" href={asset(pdf)} target="_blank" rel="noopener">
        Open the PDF <span aria-hidden="true">&rarr;</span>
      </a>
      <a class="deck__download" href={asset(pdf)} download>Download</a>
      <p class="meta deck__meta">{pages} pages &middot; {size} &middot; opens in a new tab</p>
    </div>

    <p class="deck__alt">
      If you would rather read it as a website, the same projects are on the
      <a href={href('/work/')}>work page</a>, rewritten and kept up to date.
    </p>
  </div>
</Base>

<style>
  .deck { padding-top: var(--space-7); max-width: 60rem; }
  .deck__title {
    font-size: clamp(var(--size-8), 9vw, var(--size-10));
    line-height: 0.95;
    letter-spacing: -0.01em;
    margin: var(--space-4) 0 var(--space-5);
  }
  .deck__intro { max-width: var(--measure); font-size: var(--size-5); }
  .deck__todo { margin-top: var(--space-4); max-width: var(--measure); }

  .deck__cover {
    display: block;
    margin-top: var(--space-8);
    background: var(--field);
    border-top: var(--border-mark) solid var(--ink);
  }
  .deck__cover img { width: 100%; height: auto; display: block; }

  .deck__actions {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-6);
  }
  .deck__open { font-size: var(--size-5); font-weight: var(--weight-med); }
  .deck__download { font-size: var(--size-3); }
  .deck__meta { width: 100%; }
  @media (min-width: 640px) { .deck__meta { width: auto; } }

  .deck__alt {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: var(--border-hair) solid var(--rule);
    max-width: var(--measure);
    font-size: var(--size-3);
    color: var(--ink-quiet);
  }
</style>
