---
import Base from './Base.astro';
import Rail from '../components/Rail.astro';
import { href } from '../lib/url.js';

const { entry, projects, prev, next } = Astro.props;
const d = entry.data;
---
<Base title={d.title} description={d.about} accent={d.accent}>
  <div class="page cs">
    <Rail sections={d.sections} number={d.number} projects={projects} />

    <article class="cs__body">
      <header class="cs__head">
        <p class="figure-num cs__number">{d.number}</p>
        <h1 class="cs__title">{d.title}</h1>
        {d.takeaway && <p class="cs__takeaway">{d.takeaway}</p>}

        {/* Four columns, each a heading over a stacked list: Role, Timeline,
            Skills, Tools. Read across and you have the whole shape of the job
            before a word of prose, which is what a hiring manager scans for.

            Still a <dl>, because that is what this is — four terms and their
            descriptions. The columns are a grid over the same markup, so on a
            narrow screen it collapses back to stacked rows and keeps meaning.

            The team credit sits under Role rather than in a column of its own:
            who you worked with is part of what your role was, and giving it a
            fifth column would leave five of six projects with a blank. */}
        <dl class="cs__facets">
          <div class="cs__facet">
            <dt class="eyebrow">Role</dt>
            <dd>
              <ul class="cs__facetlist">
                <li>{d.role}</li>
                {d.team && <li class="cs__with">with {d.team}</li>}
              </ul>
            </dd>
          </div>

          <div class="cs__facet">
            <dt class="eyebrow">Timeline</dt>
            <dd><ul class="cs__facetlist"><li>{d.dates}</li></ul></dd>
          </div>

          {d.skills.length > 0 && (
            <div class="cs__facet">
              <dt class="eyebrow">Skills</dt>
              <dd><ul class="cs__facetlist">{d.skills.map((s) => <li>{s}</li>)}</ul></dd>
            </div>
          )}

          {d.tools.length > 0 && (
            <div class="cs__facet">
              <dt class="eyebrow">Tools</dt>
              <dd><ul class="cs__facetlist">{d.tools.map((t) => <li>{t}</li>)}</ul></dd>
            </div>
          )}
        </dl>
      </header>

      <slot />

      <nav class="cs__next" aria-label="More work">
        <div class="cs__nextgrid">
          {prev ? (
            <a href={href(`/work/${prev.id}/`)} class="cs__nextlink">
              <span class="eyebrow">Previous</span>
              <span class="cs__nexttitle"><span class="figure-num">{prev.data.number}</span> {prev.data.shortTitle}</span>
            </a>
          ) : <span></span>}
          {next && (
            <a href={href(`/work/${next.id}/`)} class="cs__nextlink cs__nextlink--end">
              <span class="eyebrow">Next</span>
              <span class="cs__nexttitle"><span class="figure-num">{next.data.number}</span> {next.data.shortTitle}</span>
            </a>
          )}
        </div>
      </nav>
    </article>
  </div>
</Base>

<style>
  .cs { padding-top: var(--space-7); }
  @media (min-width: 1000px) {
    .cs {
      display: grid;
      grid-template-columns: var(--rail-width) minmax(0, 1fr);
      gap: var(--rail-gap);
      align-items: start;
    }
  }
  .cs__body {
    max-width: 52rem;
    min-width: 0;
    /* Text to the same column as the pictures. Prose was capped at 62ch,
       which rendered 700px, while figures, the deck, the clip and the tag
       rows all ran the full 832px, so every paragraph stopped short of every
       image beside it. Overriding the token here rather than in base.css
       keeps the comfortable measure on /about and /cv, where there are no
       pictures to line up with. */
    --measure: 100%;
  }
  .cs__number { font-size: var(--size-6); color: var(--accent-ink); line-height: 1; }
  .cs__title {
    font-size: var(--size-8);
    margin: var(--space-3) 0 var(--space-5);
    max-width: 18ch;
  }
  @media (min-width: 800px) { .cs__title { font-size: var(--size-9); } }
  /* --ink, not --accent-ink: this is body-weight prose at reading size, so it
     takes the 16.1:1 ground colour rather than an accent. The accent does the
     work on the rule above it instead. */
  .cs__takeaway {
    font-size: var(--size-4);
    line-height: var(--leading-body);
    max-width: 36ch;
    margin: 0 0 var(--space-5);
    padding-top: var(--space-4);
    border-top: var(--border-mark) solid var(--accent);
    text-wrap: pretty;
  }
  @media (min-width: 800px) { .cs__takeaway { font-size: var(--size-5); } }
  .cs__facets {
    margin: 0;
    padding-bottom: var(--space-6);
    border-bottom: var(--border-mark) solid var(--ink);
    display: grid;
    gap: var(--space-5);
  }
  /* Four columns side by side once there is room for them. minmax(0,1fr)
     rather than 1fr so a long skill — "Verification to Eurocode 2, AISC
     N690-24, SCI P414 and DOE-STD-3014" is the worst of them — wraps inside
     its column instead of forcing the column wider than its share. */
  @media (min-width: 760px) {
    .cs__facets {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-5);
      align-items: start;
    }
  }
  .cs__facet { display: grid; gap: var(--space-3); min-width: 0; }
  .cs__facet dd { margin: 0; }

  .cs__facetlist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    font-size: var(--size-3);
    line-height: var(--leading-head);
    text-wrap: pretty;
  }
  /* The collaborators, set quiet so the role itself still reads first. */
  .cs__with { color: var(--ink-quiet); }

  .cs__next { margin-top: var(--space-10); }
  .cs__nextgrid {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    padding-top: var(--space-5);
    flex-wrap: wrap;
  }
  .cs__nextlink { text-decoration: none; display: grid; gap: var(--space-2); }
  .cs__nextlink--end { text-align: right; margin-left: auto; }
  .cs__nexttitle { font-size: var(--size-5); font-weight: var(--weight-bold); }
  .cs__nextlink:hover .cs__nexttitle { text-decoration: underline; }
</style>
