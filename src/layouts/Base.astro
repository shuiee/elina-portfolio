---
import '../styles/tokens.css';
import '../styles/base.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { asset } from '../lib/url.js';

const { title, description, accent } = Astro.props;
const fullTitle = title ? `${title} — Elina J. Lee` : 'Elina J. Lee';

/* Absolute URLs for the tags that require them. Astro.site comes from
   astro.config.mjs, so these follow the deploy target without a second
   place to keep in sync. */
const desc = description ?? 'Engineer. Finding structure in creativity, and creativity in structure.';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />

    <!-- Link previews. Without these a pasted link renders as bare text in
         Slack, LinkedIn and iMessage, which is most of how a portfolio URL
         actually travels. og:image is public/images/og-card.png, a 1200x630
         card built from the same tokens as the site: --paper ground, --ink
         text, her own drawing. It is deliberately NOT the bare portrait PNG,
         which is transparent and would render black-on-black in Slack, and
         near-square so a large-summary card would crop her face. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Elina J. Lee" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(asset('/images/og-card.png'), Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={new URL(asset('/images/og-card.png'), Astro.site).href} />

    <!-- Font declarations live here, not in tokens.css: @font-face src cannot
         read a CSS variable, and this site may be served from a sub-path.
         The FILES are in public/fonts/. The family stacks are --font-* tokens. -->
    <style is:inline set:html={`
      /* Figtree — the body face. One variable file per style covers 300-900,
         split into the two subsets Google ships: nearly all of this site is
         the latin one, and latin-ext is only fetched if a page actually uses a
         character from it. Unicode-ranges copied from Google's own css2
         response so the split behaves identically self-hosted. */
      @font-face {
        font-family: "Figtree";
        font-style: normal;
        font-weight: 300 900;
        font-display: swap;
        src: url("${asset('/fonts/Figtree-latin.woff2')}") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Figtree";
        font-style: normal;
        font-weight: 300 900;
        font-display: swap;
        src: url("${asset('/fonts/Figtree-latin-ext.woff2')}") format("woff2");
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: "Figtree";
        font-style: italic;
        font-weight: 300 900;
        font-display: swap;
        src: url("${asset('/fonts/Figtree-Italic-latin.woff2')}") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Figtree";
        font-style: italic;
        font-weight: 300 900;
        font-display: swap;
        src: url("${asset('/fonts/Figtree-Italic-latin-ext.woff2')}") format("woff2");
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      /* Inter stays declared as the fallback behind Figtree. It is what the
         Matrix glyphs (✓ ✕ △) and any Korean in a label resolve to, so
         dropping it would change characters Figtree does not carry. It is only
         fetched when one of those is actually on the page. */
      @font-face {
        font-family: "InterVariable";
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url("${asset('/fonts/InterVariable.woff2')}") format("woff2");
      }
      @font-face {
        font-family: "Instrument Serif";
        font-style: italic;
        font-weight: 400;
        font-display: swap;
        src: url("${asset('/fonts/InstrumentSerif-Italic.woff2')}") format("woff2");
      }
      @font-face {
        font-family: "Optician Sans";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("${asset('/fonts/Optician-Sans.woff2')}") format("woff2");
      }
    `}></style>

    <!-- Three faces render above the fold on every page: Figtree for body,
         Instrument Serif for the h1, Optician Sans for the 01/02/03 numbers.
         All three are small — 20KB, 27KB, 13KB — so preloading them costs
         little and stops the heading and the nav numbers reflowing.
         InterVariable is NOT preloaded: it is a 352KB fallback that most pages
         never touch, and preloading it would download it on every visit. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href={asset('/fonts/Figtree-latin.woff2')} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={asset('/fonts/InstrumentSerif-Italic.woff2')} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={asset('/fonts/Optician-Sans.woff2')} />
  </head>

  <body data-accent={accent}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main"><slot /></main>
    <Footer />

    <script>
      /* The site's only orchestration: fade a section in once, as it scrolls
         into view. Opacity only — nothing moves while it is being read.
         Only elements that START below the fold are hidden, so the first paint
         is complete and nothing flashes. Disabled entirely under
         prefers-reduced-motion. */
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduce && 'IntersectionObserver' in window) {
        const belowFold = [...document.querySelectorAll('.reveal')].filter(
          (el) => el.getBoundingClientRect().top > window.innerHeight * 0.9
        );
        belowFold.forEach((el) => el.classList.add('is-hidden'));

        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.remove('is-hidden');
              io.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.02 });

        belowFold.forEach((el) => io.observe(el));
      }

      /* Clicking an email address copies it instead of throwing the reader
         into a mail client they may not use. Every mailto on the site is
         caught here rather than per page, so the behaviour cannot drift
         between the footer and the About page.

         The href stays a real mailto, which means it still works with no
         JavaScript, on middle click, and from the context menu. The handler
         only takes over when the Clipboard API is actually available: on a
         page served over plain http there is no clipboard, so the link is
         left alone and does what it always did rather than doing nothing. */
      const canCopy = !!(navigator.clipboard && window.isSecureContext);

      if (canCopy) {
        document.addEventListener('click', async (event) => {
          const link = event.target.closest('a[href^="mailto:"]');
          if (!link) return;
          /* Leave the modified clicks alone: a reader who cmd-clicks or
             middle-clicks is asking for the mail client on purpose. */
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

          const address = link.getAttribute('href').replace(/^mailto:/, '').split('?')[0];
          event.preventDefault();

          try {
            await navigator.clipboard.writeText(address);
          } catch (err) {
            window.location.href = link.getAttribute('href');
            return;
          }

          const label = link.querySelector('[data-copy-label]') || link;
          if (label.dataset.copyBusy) return;
          const original = label.textContent;
          label.dataset.copyBusy = '1';
          link.setAttribute('aria-live', 'polite');
          label.textContent = 'Copied';
          setTimeout(() => {
            label.textContent = original;
            delete label.dataset.copyBusy;
            link.removeAttribute('aria-live');
          }, 1600);
        });
      }
    </script>
  </body>
</html>
